{
    "description": "JointIdentityProvider (JIP) POC test SP: a SAML service provider behind EngineBlock that makes the design's section 7 access decision.",
    "type": "project",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.5",
        "ext-dom": "*",
        "ext-openssl": "*",
        "ext-session": "*",
        "onelogin/php-saml": "^4.3"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5",
        "slevomat/coding-standard": "^8.28",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "JointIdentityProvider\\TestSp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JointIdentityProvider\\TestSp\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.5"
        },
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "check": [
            "@phpcs",
            "@phpstan",
            "@phpunit"
        ],
        "phpcs": "phpcs --standard=ci/qa-config/phpcs.xml",
        "phpstan": "phpstan analyse --configuration=ci/qa-config/phpstan.neon --no-progress",
        "phpunit": "phpunit"
    }
}
