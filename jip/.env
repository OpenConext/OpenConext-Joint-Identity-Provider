# Committed defaults. Real environment variables win over .env files.
# Never put secrets in a committed file: EB_API_TOKEN comes from the deployment (or an
# uncommitted .env.local / .env.dev.local, see .env.local.dist).
APP_ENV=prod
APP_SHARE_DIR=var/share

# Path of the JIP configuration file (design §17); relative paths resolve against the project directory.
# Deliberately unset here: a deployment that forgets it must not fall back to the mock configuration.
JIP_CONFIG_FILE=

# What the deployment is for: mock, acceptance or production. Must equal `environment` in the
# configuration file (design §17). Deliberately unset here.
CONNECTOR_ENVIRONMENT=
