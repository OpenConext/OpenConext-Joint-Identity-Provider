# Pins and paths for the JointIdentityProvider (JIP) POC environment.
# devenv/bin/setup.sh copies this file to devenv/.env (once) and fills in JIP_SBS_API_TOKEN.

# OpenConext-devconf main, verified 2026-10-19 (commit date 2026-10-12).
DEVCONF_REPO=https://github.com/OpenConext/OpenConext-devconf.git
DEVCONF_REF=2b6f5eb41289aecd0f7429580b1ff36187217269

# EngineBlock 7.2.1: the release with the SBS start-request fields the design needs (§9 item 2, §10).
ENGINE_REPO=https://github.com/OpenConext/OpenConext-engineblock.git
ENGINE_TAG=7.2.1
ENGINE_COMMIT=9ce5c9f9d6559b2bdc63e1a2b151674344ee4cab

# Manage 9.1.0 or later is required for coin:collab_enabled (§10). devconf main ships 9.7.2.
MANAGE_VERSION=9.7.2

# Host port for devconf's MariaDB (devconf publishes 3306, which is taken on this machine).
DEVCONF_MARIADB_HOST_PORT=13306

# Compose profiles. Start JIP, mock DEZI and the test SP with the core services.
COMPOSE_PROFILES=jip

# Shared secret EngineBlock sends to JIP (sram.api_token / engineblock.api_token, >= 32 chars).
JIP_SBS_API_TOKEN=
