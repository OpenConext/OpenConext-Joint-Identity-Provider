{
    "description": "Mock DEZI provider for the JointIdentityProvider (JIP) proof of concept: a local OpenID Connect provider that imitates DEZI's protocol with synthetic data. Never use it outside local development.",
    "type": "project",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "psr/clock": "^1.0",
        "symfony/clock": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/flex": "^2.10",
        "symfony/framework-bundle": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/yaml": "7.4.*",
        "web-token/jwt-library": "^4.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5",
        "slevomat/coding-standard": "^8.28",
        "squizlabs/php_codesniffer": "^4.0",
        "symfony/browser-kit": "7.4.*"
    },
    "autoload": {
        "psr-4": {
            "MockDezi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MockDezi\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.5"
        },
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "docker": false,
            "require": "7.4.*"
        }
    },
    "scripts": {
        "check": [
            "@lint",
            "@phpcs",
            "@phpstan",
            "@phpunit"
        ],
        "lint": [
            "bin/console lint:yaml config/ fixtures/ --parse-tags",
            "bin/console lint:container"
        ],
        "phpcs": "phpcs --standard=ci/qa-config/phpcs.xml",
        "phpstan": "phpstan analyse --configuration=ci/qa-config/phpstan.neon --no-progress",
        "phpunit": "phpunit",
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    }
}
