# Committed defaults for the mock DEZI provider. Real environment variables win over .env files.
# MOCK ONLY: this application imitates DEZI with synthetic data and never runs outside local development.
APP_ENV=prod
APP_SHARE_DIR=var/share

# The provider configuration and the synthetic fixtures (relative paths resolve against the project directory).
MOCK_DEZI_CONFIG_FILE=config/mock-dezi.yaml
MOCK_DEZI_FIXTURES_FILE=fixtures/profiles.yaml

# The client's registered public certificates. Locally these are JIP's mock keys (jip/bin/init-mock-keys);
# the container mounts that directory read-only (devenv/compose/jip.override.yml).
MOCK_DEZI_CLIENT_KEYS_DIR=../jip/keys/mock

# The mock's own signing keys (bin/init-keys) and its state file (reset with bin/console mock-dezi:reset).
MOCK_DEZI_KEYS_DIR=keys
MOCK_DEZI_STATE_FILE=var/mock-dezi/state.json
