#!/usr/bin/env bash
# Creates the mock DEZI provider's own signing keys under keys/ (git-ignored): one per message type
# (ID token, envelope, statement) and one "rogue" key that no key address publishes.
# MOCK ONLY: these keys sign synthetic messages and are never used anywhere else.
# Existing files are kept; delete keys/ to start over (JIP's key cache then needs a restart or the refetch rule).
set -euo pipefail

dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)/keys"
umask 077
mkdir -p "$dir"

for name in id-token envelope statement rogue; do
    if [[ -e "$dir/$name.pem" ]]; then
        echo "kept     keys/$name.pem"
        continue
    fi
    openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out "$dir/$name.pem" 2>/dev/null
    echo "created  keys/$name.pem"
done
