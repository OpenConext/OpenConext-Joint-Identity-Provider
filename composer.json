{
    "description": "JointIdentityProvider (JIP): connects EngineBlock's SBS interface to an external OpenID Connect identity provider (DEZI) and releases its verified attributes.",
    "type": "project",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.5",
        "ext-ctype": "*",
        "ext-gmp": "*",
        "ext-iconv": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "psr/log": "^3.0",
        "symfony/cache": "7.4.*",
        "symfony/clock": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/flex": "^2.10",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-client": "7.4.*",
        "symfony/lock": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/yaml": "7.4.*",
        "web-token/jwt-library": "^4.2"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5",
        "slevomat/coding-standard": "^8.28",
        "squizlabs/php_codesniffer": "^4.0",
        "symfony/browser-kit": "7.4.*"
    },
    "autoload": {
        "psr-4": {
            "JointIdentityProvider\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JointIdentityProvider\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.5"
        },
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "docker": false,
            "require": "7.4.*"
        }
    },
    "scripts": {
        "check": [
            "@lint",
            "@phpcs",
            "@phpstan",
            "@deptrac",
            "@phpunit",
            "@dependency-audit"
        ],
        "lint": [
            "bin/console lint:yaml config/ --parse-tags",
            "bin/console lint:container"
        ],
        "phpcs": "phpcs --standard=ci/qa-config/phpcs.xml",
        "phpstan": "phpstan analyse --configuration=ci/qa-config/phpstan.neon --no-progress",
        "deptrac": [
            "deptrac analyse --config-file=ci/qa-config/deptrac.yaml --cache-file=var/cache/deptrac.cache --no-progress --fail-on-uncovered",
            "deptrac analyse --config-file=ci/qa-config/deptrac-controllers.yaml --cache-file=var/cache/deptrac-controllers.cache --no-progress --fail-on-uncovered"
        ],
        "phpunit": "phpunit",
        "dependency-audit": "@composer audit --locked --no-interaction"
    }
}
