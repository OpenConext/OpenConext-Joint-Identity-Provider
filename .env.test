KERNEL_CLASS='JointIdentityProvider\Kernel'
# Tests point JIP_CONFIG_FILE at generated configurations and keys; nothing here is a real secret.
JIP_CONFIG_FILE=
CONNECTOR_ENVIRONMENT=mock

# A MariaDB 10.6 database for test data only; every test drops and recreates JIP's table in it.
# Defaults: jip-dev's jip-mariadb service. Override in .env.test.local.
JIP_TEST_DATABASE_HOST=127.0.0.1
JIP_TEST_DATABASE_PORT=13307
JIP_TEST_DATABASE_NAME=jip_test
JIP_TEST_DATABASE_USER=jip_test
JIP_TEST_DATABASE_PASSWORD=jip_test
